def SZ.Conjecture11iv : Prop :=
∀ (k : ℕ),
  5 ≤ k →
    ∃ M,
      ∀ (m b : ℤ),
        ↑M ≤ m →
          SZ.Admissible k m b →
            (SZ.Good (k * (m - ↑k).toNat) (SZ.originalPolynomial k m b) ↔ (↑k - 2) * b ≠ ↑k * m - 4 * ↑k + 2)
def SZ.Admissible : ℕ → ℤ → ℤ → Prop :=
fun k m b => ↑k ≤ m ∧ ↑k - 2 ≤ b ∧ (↑k - 2) * b ≤ ↑k * m - 4 * ↑k + 4 ∧ 2 ∣ ↑k * (m - b)
def SZ.originalPolynomial : ℕ → ℤ → ℤ → Polynomial ℤ :=
fun k m b =>
  SZ.gaussian k (m - ↑k).toNat - Polynomial.X ^ (SZ.exponent k m b).toNat * SZ.gaussian (k - 2) (b - (↑k - 2)).toNat
def SZ.Good : ℕ → Polynomial ℤ → Prop :=
fun N P => (∀ n ≤ N, 0 ≤ P.coeff n) ∧ SZ.Unimodal N P
def SZ.Unimodal : ℕ → Polynomial ℤ → Prop :=
fun N P => ∃ p ≤ N, MonotoneOn P.coeff (Set.Icc 0 p) ∧ AntitoneOn P.coeff (Set.Icc p N)
