SZ.original_conjecture (k : ℤ) (hk : 5 ≤ k) :
  ∃ M,
    ∀ (m b : ℤ),
      ↑M ≤ m →
        k ≤ m →
          k - 2 ≤ b →
            (k - 2) * b ≤ k * m - 4 * k + 4 →
              2 ∣ k * (m - b) →
                have P :=
                  SZ.qChoose m.toNat k.toNat -
                    Polynomial.X ^ (k * (m - b) / 2 + b - 2 * k + 2).toNat * SZ.qChoose b.toNat (k - 2).toNat;
                (∀ (i : ℕ), 0 ≤ P.coeff i) ∧ SZ.Unimodal P.natDegree P ↔ (k - 2) * b ≠ k * m - 4 * k + 2
